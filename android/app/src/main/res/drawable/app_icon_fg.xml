<!-- 桌面前景（自适应图标，API 26+）：与 app.svg 同稿的星形拓扑。
     108dp 画布上内容缩到 85%（pivot 中心），确保落在安全圆（中心 66dp）内。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="256" android:viewportHeight="256">

    <group android:scaleX="0.85" android:scaleY="0.85"
        android:pivotX="128" android:pivotY="128">

        <!-- 三条入边 -->
        <group>
            <path android:strokeColor="#FFFFFF" android:strokeAlpha="0.55"
                android:strokeWidth="13" android:strokeLineCap="round"
                android:pathData="M56,58 L104,100" />
            <path android:strokeColor="#FFFFFF" android:strokeAlpha="0.55"
                android:strokeWidth="13" android:strokeLineCap="round"
                android:pathData="M46,128 L94,128" />
            <path android:strokeColor="#FFFFFF" android:strokeAlpha="0.55"
                android:strokeWidth="13" android:strokeLineCap="round"
                android:pathData="M56,198 L104,156" />
        </group>

        <!-- 汇聚核心：圆角方块旋转 45°，径向白→#BFC9D8 -->
        <group android:rotation="45" android:pivotX="136" android:pivotY="128">
            <path android:pathData="M125,102 L147,102 A15,15 0 0 1 162,117 L162,139 A15,15 0 0 1 147,154 L125,154 A15,15 0 0 1 110,139 L110,117 A15,15 0 0 1 125,102 Z">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="radial"
                        android:centerX="87" android:centerY="77" android:gradientRadius="195"
                        android:startColor="#FFFFFF" android:endColor="#BFC9D8" />
                </aapt:attr>
            </path>
        </group>

        <!-- 出边 -->
        <path android:strokeColor="#FFFFFF" android:strokeAlpha="0.95"
            android:strokeWidth="13" android:strokeLineCap="round"
            android:pathData="M172,128 L214,128" />

        <!-- 三个端点 -->
        <group android:fillColor="#FFFFFF" android:fillAlpha="0.9">
            <path android:pathData="M56,58 m-10,0 a10,10 0 1 1 20,0 a10,10 0 1 1 -20,0 Z" />
            <path android:pathData="M46,128 m-10,0 a10,10 0 1 1 20,0 a10,10 0 1 1 -20,0 Z" />
            <path android:pathData="M56,198 m-10,0 a10,10 0 1 1 20,0 a10,10 0 1 1 -20,0 Z" />
        </group>
    </group>
</vector>
