# ---------------------------------------------------------------------------
# 生产环境变量样例（2026-11-05 加固版）
#
# 用法：
#   install -m 600 deploy/prod.env.example /etc/wb2api/prod.env
#   编辑后启动：docker run --env-file /etc/wb2api/prod.env ...
#
# 规则：**这个文件不进仓库，也不进镜像**。下面只有占位符，没有真实值。
# ---------------------------------------------------------------------------

# 运行环境。写错（比如 production）会按 dev 处理，所以启动断言会再校验一次。
APP_ENV=prod

# ---- 监听 ----------------------------------------------------------------
# 只绑回环，公网流量必须经 nginx。prod 下写成 0.0.0.0 会直接拒绝启动。
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8790
# nginx 直连对端（用于采信 X-Real-IP）。容器部署时是网桥地址，按实际填。
ADMIN_TRUSTED_PROXY_IPS=127.0.0.1,::1

# ---- 凭据 ----------------------------------------------------------------
ADMIN_USERNAME=__CHANGE_ME__
ADMIN_PASSWORD=__CHANGE_ME_STRONG_PASSWORD__
# 会话签名密钥：>=32 字节随机串。生成：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=__CHANGE_ME_48_BYTES__
# join 票据签名密钥：**必须与上面不同**，独立轮换。
JOIN_TICKET_SECRET=__CHANGE_ME_ANOTHER_48_BYTES__
# 后台会话有效期（小时）。生产启动断言要求 <= 8。
ADMIN_JWT_EXPIRE_HOURS=4

# ---- 会话策略 ------------------------------------------------------------
# 同一账号只允许一个有效会话：新登录会把旧设备/旧标签页踢下线。
ADMIN_SESSION_SINGLE=1
# 会话绑定到设备 Cookie：把 admin_session 复制到别的浏览器用不了。
ADMIN_SESSION_BIND_DEVICE=1
# Cookie 鉴权的写操作强制 CSRF 双提交校验。
ADMIN_CSRF_ENABLED=1

# ---- 能力开关（生产全关）-------------------------------------------------
ADMIN_DEV_TOOLS=0
ADMIN_ENABLE_DOCS=0
# 任意路径读写/目录创建（/api/app-source 等）：生产默认关闭，
# 启动断言会检查；仅临时排障时开，用完立刻关。
ADMIN_ALLOW_FS_OPS=0

# 不要设置下面两项 —— 它们会让 /admin 绕过鉴权（生产启动断言会拦）。
# WORKBUDDY_DESKTOP=0
# WORKBUDDY_ANDROID=0

# ---- 数据库 / 缓存 -------------------------------------------------------
ADMIN_DATABASE_URL=mysql+pymysql://wb2api:__CHANGE_ME__@127.0.0.1:3306/workbuddy_prod?charset=utf8mb4
ADMIN_REDIS_URL=redis://127.0.0.1:6379/1

# ---- CORS ----------------------------------------------------------------
# 生产禁止 *，写正式域名（逗号分隔）。
ADMIN_CORS_ORIGINS=https://your-domain.example

# ---- 票据链接的对外地址 --------------------------------------------------
# 签发的 join 链接以此为准；不填则用反代覆写的 Host 头。
ADMIN_PUBLIC_BASE_URL=https://your-domain.example
# 短码票据按时间有效（默认 24h），注册页访问票据默认 4h；
# 用户要求「不要限制死只用一次」，所以不要再设成 900/3600 那种短窗口。
JOIN_TICKET_TTL=86400
JOIN_ACCESS_TTL=14400
